{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard.schema.json",
  "title": "Production storyboard",
  "type": "object",
  "required": ["title", "total_duration_seconds", "scenes"],
  "properties": {
    "title": {"type": "string"},
    "total_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "duration_seconds", "purpose", "message", "composition_pattern", "objects", "attention_sequence", "motion", "transition_out", "locked", "creative_freedom", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]{2,}$"},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "purpose": {"type": "string"},
          "message": {"type": "string"},
          "voiceover": {"type": "string"},
          "on_screen_copy": {"type": "string"},
          "composition_pattern": {"type": "string"},
          "objects": {"type": "array", "items": {"type": "object"}},
          "attention_sequence": {"type": "array", "items": {"type": "string"}},
          "motion": {"type": "array", "items": {"type": "string"}},
          "transition_out": {"type": "string"},
          "locked": {"type": "array", "items": {"type": "string"}},
          "creative_freedom": {"type": "array", "items": {"type": "string"}},
          "reference_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
