{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion-direction.schema.json",
  "title": "Motion and composition direction",
  "type": "object",
  "required": ["schema_version", "revision", "based_on", "knowledge_snapshot", "treatments", "recommended_treatment_id", "product_fidelity", "allowed_recipes", "representative_frames", "locked", "creative_freedom", "evidence_ids", "reference_ids"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 200},
    "based_on": {"type": "object", "required": ["strategy_revision", "narrative_revision"], "properties": {"strategy_revision": {"type": "string"}, "narrative_revision": {"type": "string"}}, "additionalProperties": false},
    "knowledge_snapshot": {
      "type": "object",
      "required": ["captured_at", "current_motion", "patterns", "anti_patterns"],
      "properties": {
        "captured_at": {"type": "string", "format": "date"},
        "current_motion": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/fresh-record"}},
        "patterns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/versioned-record"}},
        "anti_patterns": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/fresh-record"}}
      },
      "additionalProperties": false
    },
    "treatments": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/treatment"}},
    "recommended_treatment_id": {"type": "string", "minLength": 1},
    "product_fidelity": {"type": "object", "required": ["must_match", "may_simplify", "unknowns"], "properties": {"must_match": {"$ref": "#/$defs/strings"}, "may_simplify": {"$ref": "#/$defs/strings"}, "unknowns": {"$ref": "#/$defs/strings"}}, "additionalProperties": false},
    "allowed_recipes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "required": ["id", "version", "reason"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": false}},
    "representative_frames": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "object", "required": ["id", "communication_job", "recipe_id", "state_ids"], "properties": {"id": {"type": "string"}, "communication_job": {"type": "string"}, "recipe_id": {"type": "string"}, "state_ids": {"$ref": "#/$defs/strings"}}, "additionalProperties": false}},
    "tokens": {"type": "object"},
    "asset_gaps": {"$ref": "#/$defs/strings"},
    "anti_pattern_checks": {"type": "array", "items": {"type": "object"}},
    "locked": {"$ref": "#/$defs/strings"},
    "creative_freedom": {"$ref": "#/$defs/strings"},
    "evidence_ids": {"$ref": "#/$defs/strings"},
    "reference_ids": {"$ref": "#/$defs/strings"}
  },
  "additionalProperties": false,
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 2000}},
    "versioned-record": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 100}
      },
      "additionalProperties": false
    },
    "fresh-record": {
      "type": "object",
      "required": ["id", "version", "observed_at", "review_after", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "observed_at": {"type": "string", "format": "date"},
        "review_after": {"type": "string", "format": "date"},
        "status": {"enum": ["provisional", "reviewed", "stale"]}
      },
      "additionalProperties": false
    },
    "treatment": {
      "type": "object",
      "required": ["id", "name", "rationale", "tradeoffs", "hierarchy", "motion_functions", "tempo", "reduced_motion", "non_copy_boundary"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "rationale": {"type": "string"},
        "tradeoffs": {"$ref": "#/$defs/strings"}, "hierarchy": {"$ref": "#/$defs/strings"},
        "motion_functions": {"$ref": "#/$defs/strings"}, "tempo": {"type": "string"},
        "reduced_motion": {"type": "string"}, "non_copy_boundary": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
