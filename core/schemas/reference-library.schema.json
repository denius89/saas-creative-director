{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference-library.schema.json",
  "title": "Concrete creative reference library",
  "type": "object",
  "required": ["references", "synthesis"],
  "properties": {
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_id", "tier", "title", "url", "industry", "project_video_type", "narrative_structure", "composition_patterns", "hierarchy_focal_point", "ui_usage", "illustration_usage", "motion_patterns", "transition_patterns", "pacing", "text_density", "strengths", "weaknesses", "reusable_visual_principles", "risks_non_copy", "inspection"],
        "properties": {
          "id": {"type": "string"}, "source_id": {"type": "string"}, "tier": {"enum": ["A", "B", "C", "D"]},
          "title": {"type": "string"}, "url": {"type": "string"}, "industry": {"type": ["string", "null"]},
          "project_video_type": {"type": ["string", "null"]},
          "narrative_structure": {"type": ["array", "null"], "items": {"type": "string"}},
          "composition_patterns": {"type": ["array", "null"], "items": {"type": "string"}},
          "hierarchy_focal_point": {"type": ["string", "null"]}, "ui_usage": {"type": ["string", "null"]},
          "illustration_usage": {"type": ["string", "null"]},
          "motion_patterns": {"type": ["array", "null"], "items": {"type": "string"}},
          "transition_patterns": {"type": ["array", "null"], "items": {"type": "string"}},
          "pacing": {"type": ["string", "null"]}, "text_density": {"type": ["string", "null"]},
          "strengths": {"type": ["array", "null"], "items": {"type": "string"}},
          "weaknesses": {"type": ["array", "null"], "items": {"type": "string"}},
          "reusable_visual_principles": {"type": ["array", "null"], "items": {"type": "string"}},
          "risks_non_copy": {"type": ["array", "null"], "items": {"type": "string"}},
          "screenshots_timestamps": {"type": "array", "items": {"type": "object"}},
          "inspection": {"type": "object", "required": ["status", "method", "inspected_at", "confidence"]}
        },
        "additionalProperties": false
      }
    },
    "synthesis": {"type": "object", "required": ["patterns", "overused_devices", "opportunities"]}
  },
  "additionalProperties": false
}
